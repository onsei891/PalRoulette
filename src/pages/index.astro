    font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
    font-size: 0.95rem;
    filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.55));
  }

  .work-chip span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-chip strong {
    min-width: 20px;
