    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .work-chip[data-work="Cooling"] { --work: #9cecff; }
  .work-chip[data-work="Farming"] { --work: #f0c84b; }
  .work-chip[data-work="Gathering"] { --work: #cdb8ff; }
  .work-chip[data-work="Generating_Electricity"] { --work: #ffe45c; }
  .work-chip[data-work="Handiwork"] { --work: #ffb36a; }
  .work-chip[data-work="Kindling"] { --work: #ff694f; }
  .work-chip[data-work="Lumbering"] { --work: #79d28c; }
  .work-chip[data-work="Medicine"] { --work: #82e6b1; }
  .work-chip[data-work="Mining"] { --work: #b8c4d6; }
  .work-chip[data-work="Planting"] { --work: #84df6b; }
  .work-chip[data-work="Transporting"] { --work: #d9ae78; }
  .work-chip[data-work="Watering"] { --work: #67cfff; }

  .work-chip .chip-icon {
    width: 22px;
    height: 22px;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: var(--work);
    background:
      radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.34), transparent 34%),
