  .skill-line strong {
    color: var(--ink);
  }

  .empty-state {
    grid-column: 1 / -1;
    min-height: 140px;
    display: grid;
    place-items: center;
    margin: 0;
    border: 1px dashed var(--line);
    border-radius: 8px;
